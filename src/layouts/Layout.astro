---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site, type Theme } from '../data/site';
interface Props { title?: string; description?: string; theme?: Theme; presentation?: boolean; preview?: boolean }
const { title = `${site.name} · ${site.profession}`, description = 'Abogado y profesor universitario en Córdoba. Derecho civil, comercial, laboral, familia, concursos y quiebras y penal. Atención en barrio Cofico.', theme = 'noche', presentation = false, preview = false } = Astro.props;
---
<!doctype html>
<html lang="es-AR" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'oliva' ? '#f4f1e9' : theme === 'grafito' ? '#222326' : '#101f30'} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`/logos/sr-${theme}.svg`} />
    <title>{title}</title>
    <script is:inline>if (new URLSearchParams(location.search).get('presentacion') === '1') document.documentElement.classList.add('presentation-mode');</script>
  </head>
  <body class:list={[presentation && 'gallery-body', preview && 'has-preview']}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
